# Shared secret; Next.js route handlers send it as the X-Service-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_KEY=

# Only for local tests: lets the service start without AI_SERVICE_KEY (then no auth!).
# ALLOW_NO_KEY=1

# cpu (default) or cuda
DEVICE=cpu

# Port used by the Docker image (Hugging Face Spaces expects 7860). Local uvicorn uses --port.
PORT=7860

# Where model weights are cached. Locally keep it inside ai-service/.cache (gitignored).
HF_HOME=./.cache/hf

# Advanced: swap the detector or its thresholds (re-run tools/calibrate_quality.py and the eval if you do).
# DETECTOR_MODEL=google/owlvit-base-patch32
# DETECTOR_REVISION=
# DETECTOR_INPUT_SIZE=
# DOG_THRESHOLD=0.15
# FACE_THRESHOLD=0.02
