# Next.js app — copy to .env.local. `npx supabase status -o env` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI service (ai-service/). Must equal AI_SERVICE_KEY in ai-service/.env.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=

# Bearer token for schedulers calling POST /api/jobs/rematch (admins can also trigger it from /admin).
JOBS_SECRET=
